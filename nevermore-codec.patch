diff --git a/app/src/main/assets/yt_codec.js b/app/src/main/assets/yt_codec.js
new file mode 100644
index 0000000..b118bf7
--- /dev/null
+++ b/app/src/main/assets/yt_codec.js
@@ -0,0 +1,28 @@
+/*
+ * Stops YouTube from choosing AV1 streams. On many Android TVs (including some Xiaomi models),
+ * AV1 is decoded in software, so 1080p AV1 drops most of its frames and stutters. Reporting
+ * AV1 as unsupported makes YouTube pick H.264 (or VP9), which the TV decodes in hardware.
+ * Runs at document start so it is in place before the player checks codec support.
+ */
+(function () {
+  if (window.__ytCodecInstalled) return;
+  window.__ytCodecInstalled = true;
+
+  var AV1 = /av01/i;
+
+  try {
+    if (window.MediaSource && MediaSource.isTypeSupported) {
+      var origIsTypeSupported = MediaSource.isTypeSupported.bind(MediaSource);
+      MediaSource.isTypeSupported = function (type) {
+        return AV1.test(String(type)) ? false : origIsTypeSupported(type);
+      };
+    }
+  } catch (e) {}
+
+  try {
+    var origCanPlayType = HTMLMediaElement.prototype.canPlayType;
+    HTMLMediaElement.prototype.canPlayType = function (type) {
+      return AV1.test(String(type)) ? '' : origCanPlayType.call(this, type);
+    };
+  } catch (e) {}
+})();
diff --git a/app/src/main/java/com/bravetv/app/TvWebViewActivity.kt b/app/src/main/java/com/bravetv/app/TvWebViewActivity.kt
index da005c0..1d47c13 100644
--- a/app/src/main/java/com/bravetv/app/TvWebViewActivity.kt
+++ b/app/src/main/java/com/bravetv/app/TvWebViewActivity.kt
@@ -100,6 +100,13 @@ class TvWebViewActivity : ComponentActivity() {
                 adPruneJs,
                 setOf("https://www.youtube.com", "https://youtube.com", "https://m.youtube.com")
             )
+            // Stop YouTube choosing AV1 (software-decoded on many TVs, causes dropped frames)
+            val codecJs = assets.open("yt_codec.js").bufferedReader().use { it.readText() }
+            WebViewCompat.addDocumentStartJavaScript(
+                webView,
+                codecJs,
+                setOf("https://www.youtube.com", "https://youtube.com", "https://m.youtube.com")
+            )
         } else {
             android.util.Log.w("NeverMore", "DOCUMENT_START_SCRIPT unsupported on this WebView; update Android System WebView")
         }
